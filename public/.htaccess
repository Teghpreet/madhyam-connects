<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Secure the .env file from web access
  <Files ".env">
    Order Allow,Deny
    Deny from all
  </Files>

  # Route all other requests to index.html for React Router SPA routing
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
